# Copie para .env e preencha. O .env nunca vai para o Git.
#   cp .env.example .env

# ── PostgreSQL ───────────────────────────────────────────────
DB_HOST=localhost
DB_NAME=meu_banco_de_dados
DB_USER=seu_usuario
DB_PASSWORD=

# ── MongoDB (opcional, só se o desafio pedir) ────────────────
MONGO_URI=mongodb://localhost:27017
MONGO_DB=desafio

# ── Apache Superset ──────────────────────────────────────────
SUPERSET_URL=http://localhost:8088
SUPERSET_USER=admin
SUPERSET_PASS=admin

# Host que o Superset usa para alcançar o PostgreSQL.
#   Superset em contêiner  -> 172.17.0.1 (gateway do Docker)
#   Superset no host       -> localhost
SUPERSET_DB_HOST=172.17.0.1
